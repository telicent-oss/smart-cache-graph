    <!-- Which modules take part in an analysis. The graph and the deletion      -->
    <!-- worker are separate SonarQube projects produced by separate runs, so     -->
    <!-- each run has to leave the other's sources alone; otherwise both report   -->
    <!-- to one key and overwrite each other. Flipped by the                      -->
    <!-- sonar-deletion-worker profile at the foot of this pom. Consumed by       -->
    <!-- scg-system, scg-server, scg-docker and scg-deletion-worker;              -->
    <!-- scg-benchmark opts out of analysis entirely.                             -->
    <scg.sonar.skip.graph>false</scg.sonar.skip.graph>
