    <!-- ===================================================================== -->
    <!-- SonarQube issue exclusions [CORE-1445]                                -->
    <!--                                                                       -->
    <!-- These are scanner side exclusions and must stay in this root pom:      -->
    <!-- since SonarQube 7.6 sonar.issue.ignore.* is read at project level      -->
    <!-- only, and resourceKey patterns resolve against the project base        -->
    <!-- directory, hence the leading **/ on every pattern.                     -->
    <!--                                                                       -->
    <!-- Maven inherits these properties into each child module, so the scanner -->
    <!-- logs "Specifying issue exclusions at module level is not supported     -->
    <!-- anymore" once per module. That warning is benign; the root level       -->
    <!-- values are the ones actually applied (SONAR-11850).                    -->
    <!--                                                                       -->
    <!-- Mirror any change here in SonarQube > Project Settings > General       -->
    <!-- Settings > Analysis Scope, or SonarQube for IDE will not honour them.  -->
    <!-- ===================================================================== -->
    <sonar.issue.ignore.multicriteria>s1948servlets,s1948compaction,s2654,s1186,s2699,s2187,s3577,s115,s117,s101,s116,s6213,s3077filter,s5786,s1075,s5778,s5961,s3457tests,s2925,s107,s1845,s3516,s3776,s2093,s5443,s3252,s1452,s2629,s3878</sonar.issue.ignore.multicriteria>

    <!-- S1948: non transient field in a Serializable class.                    -->
    <!-- HttpServlet implements Serializable only as a legacy artefact. SCG     -->
    <!-- runs on embedded Jetty via Fuseki: there is no web.xml, no             -->
    <!-- distributable webapp and no session replication, so a servlet is never -->
    <!-- serialized and the injected service fields cannot leak. sonar-java's   -->
    <!-- own exception for this is hard coded to javax.servlet.http.HttpServlet -->
    <!-- and therefore never applies to our jakarta.servlet classes.            -->
    <sonar.issue.ignore.multicriteria.s1948servlets.ruleKey>java:S1948</sonar.issue.ignore.multicriteria.s1948servlets.ruleKey>
    <sonar.issue.ignore.multicriteria.s1948servlets.resourceKey>**/servlets/**/*.java</sonar.issue.ignore.multicriteria.s1948servlets.resourceKey>

    <!-- Same rule, same reasoning: the CompactOne/CompactAll/CompactionJobs    -->
    <!-- servlets are nested classes of FMod_InitialCompaction rather than      -->
    <!-- living under a servlets package.                                      -->
    <sonar.issue.ignore.multicriteria.s1948compaction.ruleKey>java:S1948</sonar.issue.ignore.multicriteria.s1948compaction.ruleKey>
    <sonar.issue.ignore.multicriteria.s1948compaction.resourceKey>**/FMod_InitialCompaction.java</sonar.issue.ignore.multicriteria.s1948compaction.resourceKey>

    <!-- S2654: "JEE applications should not use threads or synchronization".   -->
    <!-- The rule fires on every Runnable in a module it classifies as Jakarta  -->
    <!-- EE, with no carve out for a plain ExecutorService, and its prescribed  -->
    <!-- remedy (inject a container ManagedExecutorService) has no meaning for  -->
    <!-- a standalone Fuseki process on embedded Jetty. Premise does not hold.  -->
    <sonar.issue.ignore.multicriteria.s2654.ruleKey>java:S2654</sonar.issue.ignore.multicriteria.s2654.ruleKey>
    <sonar.issue.ignore.multicriteria.s2654.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.s2654.resourceKey>

    <!-- S1186: empty method. Deliberately inert methods are normal in test     -->
    <!-- doubles and stubs (for example the RDFChanges implementation in        -->
    <!-- RDFPatchInverterTest). Widened from test only to project wide, which    -->
    <!-- also covers the placeholder ActionService in FMod_CQRS and the four     -->
    <!-- no op methods in ValidationUtils. NOTE: ValidationUtils has no callers  -->
    <!-- anywhere in the tree; deleting the class would remove these outright.   -->
    <sonar.issue.ignore.multicriteria.s1186.ruleKey>java:S1186</sonar.issue.ignore.multicriteria.s1186.ruleKey>
    <sonar.issue.ignore.multicriteria.s1186.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.s1186.resourceKey>

    <!-- S2699: test with no assertion. Several tests deliberately assert only  -->
