    <sonar.issue.ignore.multicriteria.s5786.ruleKey>java:S5786</sonar.issue.ignore.multicriteria.s5786.ruleKey>
    <sonar.issue.ignore.multicriteria.s5786.resourceKey>**/src/test/java/**/*.java</sonar.issue.ignore.multicriteria.s5786.resourceKey>

