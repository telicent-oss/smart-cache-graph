    <sonar.issue.ignore.multicriteria.s3516.ruleKey>java:S3516</sonar.issue.ignore.multicriteria.s3516.ruleKey>
    <sonar.issue.ignore.multicriteria.s3516.resourceKey>**/SPARQL_Update_CQRS.java</sonar.issue.ignore.multicriteria.s3516.resourceKey>

