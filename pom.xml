    <!--   S115 constant naming, S116 field naming,                            -->
    <!--   S117 local variable and parameter naming, S101 class naming.         -->
    <sonar.issue.ignore.multicriteria.s115.ruleKey>java:S115</sonar.issue.ignore.multicriteria.s115.ruleKey>
    <sonar.issue.ignore.multicriteria.s115.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.s115.resourceKey>
