    <!-- Files.createTempFile and owner only Posix file permissions.             -->
    <sonar.issue.ignore.multicriteria.s5443.ruleKey>java:S5443</sonar.issue.ignore.multicriteria.s5443.ruleKey>
    <sonar.issue.ignore.multicriteria.s5443.resourceKey>**/SmartCacheGraph.java</sonar.issue.ignore.multicriteria.s5443.resourceKey>

