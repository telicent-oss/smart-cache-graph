    <sonar.issue.ignore.multicriteria.s2699.ruleKey>java:S2699</sonar.issue.ignore.multicriteria.s2699.ruleKey>
    <sonar.issue.ignore.multicriteria.s2699.resourceKey>**/src/test/java/**/*.java</sonar.issue.ignore.multicriteria.s2699.resourceKey>

    <!-- S2187 / S3577: class looks like a test but has no test methods, and    -->
    <!-- test class naming convention. We use the *_Test suffix for hand        -->
    <!-- written test doubles and fixtures, which are not test classes.         -->
    <sonar.issue.ignore.multicriteria.s2187.ruleKey>java:S2187</sonar.issue.ignore.multicriteria.s2187.ruleKey>
    <sonar.issue.ignore.multicriteria.s2187.resourceKey>**/src/test/java/**/*.java</sonar.issue.ignore.multicriteria.s2187.resourceKey>
    <sonar.issue.ignore.multicriteria.s3577.ruleKey>java:S3577</sonar.issue.ignore.multicriteria.s3577.ruleKey>
