    <sonar.issue.ignore.multicriteria.s3776.ruleKey>java:S3776</sonar.issue.ignore.multicriteria.s3776.ruleKey>
    <sonar.issue.ignore.multicriteria.s3776.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.s3776.resourceKey>

